JWT_SECRET=c0a418ba-8422-45d6-83d9-8989746e97c2
JWT_EXPIRY=15m
BCRYPT_SALT_ROUNDS=12

# Dev-only: when set to "true", POST /api/password-reset/request echoes the
# raw reset token in its response so the flow can be tested without an email
# provider wired up. Leave unset (or anything other than "true") in every
# real deployment — the safe default is to never expose the token.
ALLOW_DEV_PASSWORD_RESET_TOKEN=false

# Razorpay — RAZORPAY_KEY_SECRET is a real secret, backend-only, used to sign
# order requests and verify payment signatures. RAZORPAY_KEY_ID is NOT a
# secret (Razorpay's own Checkout.js requires it client-side) — it's also
# returned by POST /api/subscription/checkout for the frontend to use.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Separate secret shown when you configure the webhook URL in the Razorpay
# dashboard (Settings -> Webhooks -> add https://<your-domain>/api/webhooks/razorpay,
# subscribe to "payment.captured"). Different from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=
